# Root gitignore for Prominentz Multi-App Repository

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Next.js Build Output
platform/.next/
platform/out/
platform/build/

# Expo / React Native Output
mobile/.expo/
mobile/dist/
mobile/.metro/

# Environment Files (Keep secrets private, commit example only)
.env*
platform/.env*
mobile/.env*
!.env.example
!platform/.env.example
!mobile/.env.example
!.env.production.example
!platform/.env.production.example

# Scratch scripts & temporary build artifacts
platform/scratch/
platform/public/receipts/*.html
*.tsbuildinfo
*.pem
brag-output/
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
