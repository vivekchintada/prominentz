# ═══════════════════════════════════════════════════════════════════════════════
# RESTO AI — PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ── 1. DATABASE (Managed PostgreSQL: Supabase, Neon, AWS RDS, or Railway) ─────
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── 2. NEXTAUTH AUTHENTICATION ────────────────────────────────────────────────
# Run `openssl rand -base64 32` or paste a 32+ character random string
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_32_CHAR_RANDOM_SECRET_KEY"
# Your live production domain (e.g. https://resto.yourdomain.com or https://resto-platform.vercel.app)
NEXTAUTH_URL="https://your-production-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-production-app.vercel.app"

# ── 3. REDIS (Event Bus: Upstash Redis, Railway, or AWS ElastiCache) ───────────
# Example: rediss://default:xxxx@us1-merry-cat-34567.upstash.io:6379
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# ── 4. STRIPE (Payments & POS Subscriptions) ──────────────────────────────────
# From: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# From: https://dashboard.stripe.com/webhooks (Endpoint: https://your-production-app.com/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET="whsec_..."
# From: https://dashboard.stripe.com/products (Monthly $40 Basic Plan Price ID)
STRIPE_PRICE_BASIC="price_..."


# ── 5. EMAIL NOTIFICATIONS (Resend) ───────────────────────────────────────────
# From: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Resto AI <orders@yourverifieddomain.com>"

# ── 6. SMS / WHATSAPP WAITLIST & PAGING (Twilio) ──────────────────────────────
# From: https://console.twilio.com
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ── 7. BACKGROUND AUTOMATION & CRONS ──────────────────────────────────────────
# Secret token to protect /api/cron/* endpoints
CRON_SECRET="GENERATE_A_RANDOM_SECRET_FOR_CRON_JOBS"

# ── 8. CLOUDFLARE R2 ASSET STORAGE (Optional for launch) ──────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="resto-assets"
R2_PUBLIC_URL=""
