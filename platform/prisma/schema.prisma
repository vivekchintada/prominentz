// Resto AI — Phase 1 Prisma Schema
// "Each event happens once. Every module reacts automatically."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum PlanTier {
  STARTER
  PRO
  ENTERPRISE
}

enum OrderSource {
  POS
  QR_TABLE
  DELIVERY_DOORDASH
  DELIVERY_UBEREATS
  DELIVERY_OTHER
  WEB_PICKUP
  WEB_DELIVERY
  QR_DINE_IN
}

enum FulfilmentType {
  PICKUP
  DELIVERY
  DINE_IN
}

enum OnlineOrderStatus {
  DRAFT
  PAYMENT_PENDING
  PENDING_ACCEPTANCE
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  DELIVERED
  REJECTED
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
}

enum OrderingAcceptanceMode {
  AUTOMATIC
  MANUAL
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum UserRole {
  OWNER
  MANAGER
  SERVER
  KITCHEN
}

enum TableStatus {
  EMPTY
  ACTIVE
  PAYING
  RESERVED
}

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  PARTIALLY_READY
  READY
  PAID
  HOLD
  VOIDED
}

enum OrderItemStatus {
  PENDING
  IN_PROGRESS
  READY
  SERVED
  VOIDED // Cancelled before being served — set when parent order is voided
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  READY
  SERVED
  VOIDED // KDS ticket cancelled — kitchen must stop work on this ticket
}

enum TicketItemStatus {
  PENDING
  IN_PROGRESS
  READY
  VOIDED // Individual line-item cancelled
}

enum PaymentMethod {
  CARD
  CASH
  APPLE_PAY
  GOOGLE_PAY
  GIFT_CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum KdsStation {
  HOT
  COLD
  BAR
  EXPO
}

enum TimeEntryStatus {
  ACTIVE
  COMPLETED
  FLAGGED // Geofence mismatch, overtime anomaly, or missed clock-out
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// ─── RESTAURANT & LOCATION ───────────────────────────────────────────────────

model Restaurant {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  planTier             PlanTier  @default(STARTER)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  onboardingStep       Int       @default(0) // 0=new, 5=complete
  settings             Json?     @default("{}")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  locations      Location[]
  users          User[]
  categories     MenuCategory[]
  customers      Customer[]
  loyaltyRewards LoyaltyReward[]
  coupons        Coupon[]
  addons         MenuAddon[]
  loyaltyConfig  LoyaltyConfig?
  loyaltyTiers   LoyaltyTier[]
  marketingCampaigns MarketingCampaign[]
}

model Location {
  id             String   @id @default(cuid())
  restaurantId   String
  name           String
  address        String?
  phone          String?
  timezone       String   @default("UTC")
  region         String?  // e.g. "North Region", "West Coast"
  isHeadquarters Boolean  @default(false)
  lat            Float?
  lng            Float?
  geofenceRadiusM Float   @default(150.0) // Radius in meters
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])
  tables         Table[]
  categories     MenuCategory[]
  kdsStations    KdsStationConfig[]
  employees      Employee[]
  inventoryItems InventoryItem[]
  inventoryAlerts InventoryAlert[]
  shifts         Shift[]
  timeEntries    TimeEntry[]
  tasks          Task[]
  reservations   Reservation[]
  waitlistEntries WaitlistEntry[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  stockCountSessions StockCountSession[]
  wasteLogs      WasteLog[]
  scheduleVersions ScheduleVersion[]
  shiftTemplates ShiftTemplate[]
  coverageRules  CoverageRule[]
  overtimeRule   OvertimeRule?
  onlineOrderingConfig OnlineOrderingConfig?
  deliveryAddresses OrderDeliveryAddress[]
  orderingHolidays OrderingHoliday[]
  deliveryProviders      DeliveryProvider[]
  deliveryStatements     DeliveryStatement[]
  reconciliationPeriods  ReconciliationPeriod[]
}

// ─── AUTH / USERS ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  restaurantId String
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id])
  sessions    Session[]
  orders      Order[]
  payments    Payment[]
  voids       Void[]
  orderVoids  OrderVoid[] @relation("OrderVoidUser") // order-level voids initiated by this user
  employee    Employee?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── MENU ────────────────────────────────────────────────────────────────────

model MenuCategory {
  id               String   @id @default(cuid())
  restaurantId     String
  locationId       String?
  masterCategoryId String?  // Optional reference if pushed from HQ master category
  name             String
  imageUrl         String?
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])
  items      MenuItem[]
}

model MenuItem {
  id           String     @id @default(cuid())
  categoryId   String
  masterItemId String?    // Reference to HQ master item if synced
  isMasterItem Boolean    @default(false)
  name         String
  description  String?
  price        Decimal    @db.Decimal(10, 2)
  netPrice     Decimal?   @db.Decimal(10, 2)
  imageUrl     String?
  isVeg        Boolean    @default(false)
  isAvailable  Boolean    @default(true)
  is86d        Boolean    @default(false)
  prepTimeEstimateMin Int @default(15)
  taxRate      Decimal    @db.Decimal(5, 4) @default(0.0)
  displayOrder Int        @default(0)
  kdsStation   KdsStation @default(HOT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  category     MenuCategory     @relation(fields: [categoryId], references: [id])
  modifiers    MenuModifier[]
  orderItems   OrderItem[]
  availability AvailabilityLog[]
  kdsTicketItems KdsTicketItem[]
  recipeItems RecipeItem[]
}

model MenuModifier {
  id           String   @id @default(cuid())
  menuItemId   String
  name         String   // e.g. "Size", "Extras", "Remove"
  isRequired   Boolean  @default(false)
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  menuItem MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]
}

model ModifierOption {
  id              String   @id @default(cuid())
  modifierId      String
  name            String   // e.g. "Large", "Extra Cheese", "No Onions"
  priceAdjustment Decimal  @db.Decimal(10, 2) @default(0.0)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  modifier MenuModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
}

model AvailabilityLog {
  id         String   @id @default(cuid())
  menuItemId String
  action     String   // '86D' | 'RESTORED'
  reason     String?
  changedBy  String
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model MenuAddon {
  id           String     @id @default(cuid())
  restaurantId String
  parentItem   String     // e.g. "Pizza", "Sauce", "Sea Food", "Salad", "Topping", "Side Dish"
  name         String     // e.g. "Extra Cheese", "Garlic Butter Sauce"
  price        Decimal    @db.Decimal(10, 2)
  status       String     @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Coupon {
  id             String    @id @default(cuid())
  restaurantId   String
  code           String    // e.g. "SEAFOOD10", "PIZZA20"
  validCategory  String?   // category name or null for "All Categories"
  discountType   String    // "PERCENTAGE" | "FIXED"
  discountAmount Decimal   @db.Decimal(10, 2)
  startDate      DateTime?
  endDate        DateTime?
  pointsCost     Int?      @default(0) // Customer loyalty points required to unlock/redeem
  pointsReward   Int?      @default(0) // Loyalty points earned when using this coupon
  status         String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "INACTIVE"
  usageLimit     Int?
  usageCount     Int       @default(0)
  minimumOrderAmount Decimal? @db.Decimal(10, 2)
  channels       Json      @default("[\"POS\", \"ONLINE\", \"QR\"]")
  perCustomerLimit Int?    @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@index([restaurantId])
}

// ─── TABLES ──────────────────────────────────────────────────────────────────

model Table {
  id         String      @id @default(cuid())
  locationId String
  name       String      // e.g. "Table 1", "Bar 3", "Patio 2"
  capacity   Int
  status     TableStatus @default(EMPTY)
  floor      String      @default("1st Floor")
  shape      String      @default("square") // square | rectangle | round
  note       String?
  posX       Int?        // position on table map grid
  posY       Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  location Location @relation(fields: [locationId], references: [id])
  orders   Order[]
  reservations Reservation[]
}

// ─── ORDERS ──────────────────────────────────────────────────────────────────

model Order {
  id                      String      @id @default(cuid())
  tableId                 String
  serverId                String?
  customerId              String?
  status                  OrderStatus @default(OPEN)
  orderSource             OrderSource @default(POS)
  deliveryPlatformOrderId String?     // External delivery platform order ID
  guestCount              Int         @default(1)
  notes                   String?
  subtotal                Decimal     @db.Decimal(10, 2) @default(0.0)
  tax                     Decimal     @db.Decimal(10, 2) @default(0.0)
  total                   Decimal     @db.Decimal(10, 2) @default(0.0)
  publicOrderNumber       String?     @unique
  trackingToken           String?     @unique
  fulfilmentType          FulfilmentType?
  onlineStatus            OnlineOrderStatus?
  customerName            String?
  customerEmail           String?
  customerPhone           String?
  scheduledFor            DateTime?
  estimatedReadyAt        DateTime?
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  readyAt                 DateTime?
  completedAt             DateTime?
  discount                Decimal     @db.Decimal(10, 2) @default(0.0)
  serviceCharge           Decimal     @db.Decimal(10, 2) @default(0.0)
  deliveryFee             Decimal     @db.Decimal(10, 2) @default(0.0)
  tip                     Decimal     @db.Decimal(10, 2) @default(0.0)
  paymentStatus           String      @default("UNPAID")
  stripePaymentIntentId   String?
  refundId                String?
  refundAmount            Decimal?    @db.Decimal(10, 2)
  idempotencyKey          String?     @unique
  voidedAt                DateTime?   // Set when status transitions to VOIDED
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  table      Table       @relation(fields: [tableId], references: [id])
  server     User?       @relation(fields: [serverId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  tickets    KdsTicket[]
  payments   Payment[]
  events     OrderEvent[]
  deliveryAddress OrderDeliveryAddress?
  orderVoid  OrderVoid?  // Direct link to the order-level void record

  @@index([onlineStatus, scheduledFor])
  @@index([createdAt, fulfilmentType])
  @@index([status, createdAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  menuItemId   String
  quantity     Int             @default(1)
  seatNumber   Int             @default(1)
  priceAtOrder Decimal         @db.Decimal(10, 2)
  modifiers    Json            @default("[]") // [{modifierName, optionName, priceDelta}]
  specialNote  String?
  status       OrderItemStatus @default(PENDING)
  station      KdsStation?
  hold         Boolean         @default(false)
  firedAt      DateTime?
  prepStartedAt DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  eventType String   // order.created, order.sent_to_kitchen, etc.
  actorId   String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([eventType])
}

// ─── KDS ─────────────────────────────────────────────────────────────────────

model KdsStationConfig {
  id         String     @id @default(cuid())
  locationId String
  station    KdsStation
  name       String     // Display name e.g. "Hot Kitchen"
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())

  location  Location     @relation(fields: [locationId], references: [id])
}

model KdsTicket {
  id        String       @id @default(cuid())
  orderId   String
  station   KdsStation
  status    TicketStatus @default(NEW)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  readyAt   DateTime?
  servedAt  DateTime?

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items KdsTicketItem[]

  @@index([orderId, status])
}

model KdsTicketItem {
  id          String           @id @default(cuid())
  ticketId    String
  menuItemId  String
  quantity    Int
  modifiers   Json             @default("[]")
  specialNote String?
  status      TicketItemStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  ticket KdsTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

// ─── PAYMENTS ────────────────────────────────────────────────────────────────

model Payment {
  id                   String        @id @default(cuid())
  orderId              String
  processedBy          String
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  subtotal             Decimal       @db.Decimal(10, 2)
  tax                  Decimal       @db.Decimal(10, 2)
  tip                  Decimal       @db.Decimal(10, 2) @default(0.0)
  total                Decimal       @db.Decimal(10, 2)
  stripePaymentIntentId String?
  stripeChargeId       String?
  cashReceived         Decimal?      @db.Decimal(10, 2)
  cashChange           Decimal?      @db.Decimal(10, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order      Order          @relation(fields: [orderId], references: [id])
  processor  User           @relation(fields: [processedBy], references: [id])
  splits     PaymentSplit[]
  void       Void?
  receipt    Receipt?
}

model PaymentSplit {
  id        String        @id @default(cuid())
  paymentId String
  guestRef  String        // e.g. "Guest 1", "Jane"
  method    PaymentMethod
  subtotal  Decimal       @db.Decimal(10, 2)
  tip       Decimal       @db.Decimal(10, 2) @default(0.0)
  total     Decimal       @db.Decimal(10, 2)
  stripePaymentIntentId String?
  createdAt DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

model Void {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  voidedBy    String
  reason      String
  refundId    String?  // Stripe refund ID
  refundAmount Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  payment  Payment @relation(fields: [paymentId], references: [id])
  voidedByUser User @relation(fields: [voidedBy], references: [id])
}

// ─── ORDER-LEVEL VOID (separate from payment void — covers comps & pre-payment cancels)
model OrderVoid {
  id        String   @id @default(cuid())
  orderId   String   @unique
  voidedBy  String   // userId who initiated the void
  reason    String
  createdAt DateTime @default(now())

  order        Order @relation(fields: [orderId], references: [id])
  voidedByUser User  @relation("OrderVoidUser", fields: [voidedBy], references: [id])
}

model Receipt {
  id        String   @id @default(cuid())
  paymentId String   @unique
  url       String   // PDF stored in R2
  sentTo    String?  // email or phone
  sentAt    DateTime?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

// ─── EMPLOYEES (Phase 1 — basic, expanded in Phase 2 for labor mgmt) ─────────

model Employee {
  id                String    @id @default(cuid())
  locationId        String
  userId            String    @unique
  jobTitle          String?
  phone             String?
  hourlyRate        Decimal?  @db.Decimal(10, 2)
  employmentType    EmploymentType @default(PART_TIME)
  maxWeeklyHours    Int       @default(40)
  minRestHours      Int       @default(10)
  overtimeEligible  Boolean   @default(true)
  hireDate          DateTime?
  emergencyContact  String?   // "Name — Phone"
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  location      Location             @relation(fields: [locationId], references: [id])
  shifts        Shift[]
  timeEntries   TimeEntry[]
  tasks         Task[]
  leaveRequests LeaveRequest[]
  availability  WorkerAvailability[]
  tradeRequestsSent     ShiftTradeRequest[] @relation("TradeRequester")
  tradeRequestsReceived ShiftTradeRequest[] @relation("TradeTarget")
}

enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
  PREFERRED
}

model WorkerAvailability {
  id         String           @id @default(cuid())
  employeeId String
  dayOfWeek  Int              // 0 (Sun) to 6 (Sat)
  type       AvailabilityType @default(AVAILABLE)
  startTime  String?          // e.g. "09:00"
  endTime    String?          // e.g. "17:00"
  specificDate DateTime?      // optional one-off override
  isRecurring Boolean         @default(true)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, dayOfWeek])
  @@index([employeeId, specificDate])
}

// ─── INVENTORY & AUTO-86 (Phase 2 — Week 9) ──────────────────────────────────

enum InventoryTransactionType {
  STOCK_IN
  DEPLETION_ORDER
  WASTE
  ADJUSTMENT
}

model InventoryItem {
  id           String      @id @default(cuid())
  locationId   String
  name         String      // e.g. "Beef Patty"
  unit         String      // e.g. "pcs", "g", "oz"
  category     String?
  unitCost     Decimal     @db.Decimal(12, 4) @default(0.0)
  parStock     Float       @default(0.0)
  currentStock Float       @default(0.0)
  minStock     Float       @default(0.0) // alert threshold
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  location     Location    @relation(fields: [locationId], references: [id])
  recipes      RecipeItem[]
  transactions InventoryTransaction[]
  alerts       InventoryAlert[]
  purchaseOrderItems PurchaseOrderItem[]
  stockCountItems StockCountItem[]
  wasteLogs      WasteLog[]

  @@unique([locationId, name])
  @@index([locationId, currentStock])
}

model RecipeItem {
  id              String        @id @default(cuid())
  menuItemId      String
  inventoryItemId String
  quantityRequired Float       // Quantity depleted per menu item sold

  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([menuItemId, inventoryItemId])
}

model InventoryTransaction {
  id              String                 @id @default(cuid())
  inventoryItemId String
  type            InventoryTransactionType
  quantity        Float                  // Positive or negative
  orderId         String?                // Optional link to order causing depletion
  actorId         String?                // Optional link to employee modifying stock
  notes           String?
  createdAt       DateTime               @default(now())

  inventoryItem   InventoryItem          @relation(fields: [inventoryItemId], references: [id])
}

model InventoryAlert {
  id              String   @id @default(cuid())
  inventoryItemId String
  locationId      String
  type            String   // LOW_STOCK | OUT_OF_STOCK | RESTOCKED
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  location        Location      @relation(fields: [locationId], references: [id])
}

enum StockCountStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model StockCountSession {
  id            String           @id @default(cuid())
  locationId    String
  sessionNumber String           // e.g. "SC-2026-001"
  status        StockCountStatus @default(DRAFT)
  createdById   String
  notes         String?
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  location      Location         @relation(fields: [locationId], references: [id])
  items         StockCountItem[]

  @@unique([locationId, sessionNumber])
  @@index([locationId, status])
}

model StockCountItem {
  id                  String            @id @default(cuid())
  stockCountSessionId String
  inventoryItemId     String
  expectedQuantity    Float
  countedQuantity     Float
  variance            Float             // counted - expected
  unitCost            Decimal           @db.Decimal(12, 4) @default(0.0)
  varianceCost        Decimal           @db.Decimal(12, 4) @default(0.0)
  notes               String?
  createdAt           DateTime          @default(now())

  stockCountSession   StockCountSession @relation(fields: [stockCountSessionId], references: [id], onDelete: Cascade)
  inventoryItem       InventoryItem     @relation(fields: [inventoryItemId], references: [id])

  @@unique([stockCountSessionId, inventoryItemId])
}

enum WasteReason {
  SPOILED
  EXPIRED
  PREP_MISTAKE
  DROPPED
  CUSTOMER_COMPLAINT
  OTHER
}

enum WasteStatus {
  PENDING
  APPROVED
  REJECTED
}

model WasteLog {
  id              String      @id @default(cuid())
  locationId      String
  inventoryItemId String
  quantity        Float
  unitCost        Decimal     @db.Decimal(12, 4) @default(0.0)
  totalCost       Decimal     @db.Decimal(12, 4) @default(0.0)
  reason          WasteReason @default(SPOILED)
  status          WasteStatus @default(APPROVED)
  reportedById    String
  approvedById    String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  location        Location      @relation(fields: [locationId], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([locationId, createdAt])
}

// ─── LABOR MANAGEMENT (Phase 2) ──────────────────────────────────────────────

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Shift {
  id             String      @id @default(cuid())
  employeeId     String
  locationId     String
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  clockIn        DateTime?
  clockOut       DateTime?
  breakMinutes   Int         @default(0)
  station        String?
  hourlyRateSnapshot Decimal? @db.Decimal(10, 2)
  publishedAt    DateTime?
  publishedBy    String?
  status         ShiftStatus @default(SCHEDULED)
  role           UserRole    // Role active during this shift
  isOpen         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  employee       Employee            @relation(fields: [employeeId], references: [id])
  location       Location            @relation(fields: [locationId], references: [id])
  timeEntries    TimeEntry[]
  notes          ShiftNote[]
  tradeRequests  ShiftTradeRequest[]

  @@index([locationId, scheduledStart])
  @@index([employeeId, scheduledStart])
}

model ShiftNote {
  id        String   @id @default(cuid())
  shiftId   String
  note      String
  createdBy String   // userId
  createdAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id])
}

// ─── SHIFT SWAPPING & TRADES (Deputy HR) ──────────────────────────────────────

enum TradeStatus {
  PENDING_PEER
  PENDING_MANAGER
  APPROVED
  DENIED
  CANCELLED
}

model ShiftTradeRequest {
  id               String      @id @default(cuid())
  shiftId          String
  requesterId      String
  targetEmployeeId String?     // optional specific coworker or null for open trade pool
  status           TradeStatus @default(PENDING_PEER)
  reason           String?
  managerNote      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  shift          Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requester      Employee  @relation("TradeRequester", fields: [requesterId], references: [id])
  targetEmployee Employee? @relation("TradeTarget", fields: [targetEmployeeId], references: [id])
}

model ScheduleVersion {
  id            String   @id @default(cuid())
  locationId    String
  weekStart     DateTime
  versionNumber Int      @default(1)
  shiftCount    Int      @default(0)
  publishedBy   String
  publishedAt   DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, weekStart])
}

model ShiftTemplate {
  id          String   @id @default(cuid())
  locationId  String
  name        String   // e.g. "Dinner Line Cook (4p - 11p)"
  role        UserRole
  station     String?
  dayOfWeek   Int      // 0 = Sun, 1 = Mon ... 6 = Sat
  startTime   String   // "16:00"
  endTime     String   // "23:00"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, dayOfWeek])
}

model CoverageRule {
  id          String   @id @default(cuid())
  locationId  String
  dayOfWeek   Int      // 0-6
  role        UserRole
  station     String?
  minStaff    Int      @default(1)
  targetStaff Int      @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])

  @@unique([locationId, dayOfWeek, role, station])
}

model OvertimeRule {
  id                   String   @id @default(cuid())
  locationId           String   @unique
  dailyThresholdHours  Float    @default(8.0)
  weeklyThresholdHours Float    @default(40.0)
  overtimeMultiplier   Float    @default(1.5)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])
}

// ─── TIMECARDS / GEOFENCE ATTENDANCE ─────────────────────────────────────────

model TimeEntry {
  id             String          @id @default(cuid())
  employeeId     String
  shiftId        String?
  locationId     String
  clockIn        DateTime        @default(now())
  clockOut       DateTime?
  clockInLat     Float?
  clockInLng     Float?
  distanceMeters Float?
  breakMinutes   Int             @default(0)
  status         TimeEntryStatus @default(ACTIVE)
  flagReason     String?
  approvedAt     DateTime?
  approvedBy     String?
  managerNote    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift?    @relation(fields: [shiftId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, status])
  @@index([employeeId, clockIn])
}

// ─── FLOOR TASKS & ALERTS ───────────────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  locationId   String
  createdById  String?      // Staff or system generated
  assignedToId String?      // Target employee (nullable if role broadcast)
  role         UserRole?    // Broadcast to SERVER, RUNNER, etc.
  message      String
  taskType     String       @default("FLOOR") // "FOOD_READY", "BUSSING", "MANAGER_CALL", "SPILL"
  orderId      String?
  tableId      String?
  priority     TaskPriority @default(NORMAL)
  status       TaskStatus   @default(OPEN)
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  location Location  @relation(fields: [locationId], references: [id])
  employee Employee? @relation(fields: [assignedToId], references: [id])

  @@index([locationId, status])
}

// ─── LEAVE MANAGEMENT (Phase 2 — Week 4) ─────────────────────────────────────

enum LeaveType {
  SICK
  VACATION
  PERSONAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  type        LeaveType
  status      LeaveStatus @default(PENDING)
  startDate   DateTime
  endDate     DateTime
  reason      String?
  reviewedBy  String?     // userId of manager who acted
  reviewNote  String?     // optional manager comment
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
}

// ─── RESERVATIONS (Phase 2) ───────────────────────────────────────────────────

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id          String            @id @default(cuid())
  locationId  String
  tableId     String?
  guestName   String
  guestPhone  String
  guestEmail  String?
  partySize   Int
  scheduledAt DateTime
  status      ReservationStatus @default(PENDING)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  location    Location  @relation(fields: [locationId], references: [id])
  table       Table?    @relation(fields: [tableId], references: [id])
}

// ─── WAITLIST (Phase 2) ───────────────────────────────────────────────────────

enum WaitlistStatus {
  WAITING
  SEATED
  LEFT
}

model WaitlistEntry {
  id              String        @id @default(cuid())
  locationId      String
  guestName       String
  guestPhone      String
  partySize       Int
  quotedWaitMins  Int           @default(20)
  arrivedAt       DateTime      @default(now())
  seatedAt        DateTime?
  leftAt          DateTime?
  status          WaitlistStatus @default(WAITING)
  createdAt       DateTime      @default(now())

  location        Location      @relation(fields: [locationId], references: [id])
}

// ─── SUPPLIERS & PURCHASE ORDERS (Phase 2 — Week 9) ───────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Supplier {
  id           String          @id @default(cuid())
  locationId   String
  name         String          // Vendor company name e.g. "US Foods", "Metro Wholesalers"
  contactName  String?
  email        String?
  phone        String?
  leadTimeDays Int             @default(3)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  location       Location        @relation(fields: [locationId], references: [id])
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  locationId  String
  supplierId  String
  poNumber    String              @unique // e.g. "PO-2026-001"
  status      PurchaseOrderStatus @default(DRAFT)
  totalCost   Decimal             @db.Decimal(10, 2) @default(0.0)
  orderedAt   DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  location Location            @relation(fields: [locationId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  inventoryItemId  String
  quantity         Float
  receivedQuantity Float         @default(0.0)
  unitCost         Decimal       @db.Decimal(10, 2)
  totalCost        Decimal       @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

// ─── CUSTOMER CRM & LOYALTY (Phase 3 — Module 4) ─────────────────────────────

enum PointsLedgerType {
  EARNED_PURCHASE
  REDEEMED
  MANUAL_ADJUSTMENT
  REFUND_REVERSAL
  WELCOME_BONUS
  BIRTHDAY_BONUS
  EXPIRED
}

enum CampaignChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

enum CampaignSegment {
  ALL
  NEW
  REPEAT
  HIGH_VALUE
  LAPSED
  BIRTHDAY
  DIETARY
}

model Customer {
  id                       String    @id @default(cuid())
  restaurantId             String
  name                     String
  phone                    String    @unique
  email                    String?
  pointsBalance            Int       @default(0)
  lifetimeSpend            Decimal   @db.Decimal(10, 2) @default(0.0)
  totalVisits              Int       @default(0)
  allergyTags              Json      @default("[]") // e.g. ["Peanuts", "Gluten-Free"]
  tags                     Json      @default("[]") // e.g. ["VIP", "Regular", "Wine Lover"]
  marketingConsentEmail    Boolean   @default(true)
  marketingConsentSms      Boolean   @default(true)
  marketingConsentWhatsApp Boolean   @default(false)
  consentRecordedAt        DateTime  @default(now())
  birthDate                DateTime?
  lastVisitAt              DateTime?
  source                   String    @default("POS") // POS, QR_TABLE, ONLINE, PHONE, DELIVERY
  notes                    String?
  tierId                   String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id])
  tier          LoyaltyTier?        @relation(fields: [tierId], references: [id], onDelete: SetNull)
  orders        Order[]
  redemptions   LoyaltyRedemption[]
  ledgerEntries PointsLedger[]

  @@index([restaurantId])
  @@index([restaurantId, lifetimeSpend])
  @@index([tierId])
}

model LoyaltyConfig {
  id                      String   @id @default(cuid())
  restaurantId            String   @unique
  pointsPerDollar         Float    @default(1.0)
  pointsExpiryDays        Int?     @default(365)
  welcomeBonusPoints      Int      @default(0)
  birthdayBonusPoints     Int      @default(0)
  minimumRedemptionPoints Int      @default(100)
  isEnabled               Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model LoyaltyTier {
  id               String   @id @default(cuid())
  restaurantId     String
  name             String   // e.g. "Bronze", "Silver", "Gold", "VIP"
  minimumSpend     Decimal  @db.Decimal(10, 2) @default(0.0)
  pointsMultiplier Float    @default(1.0)
  perks            Json     @default("[]")
  badgeColor       String   @default("#6366f1")
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customers  Customer[]

  @@unique([restaurantId, name])
  @@index([restaurantId, minimumSpend])
}

model PointsLedger {
  id           String           @id @default(cuid())
  customerId   String
  orderId      String?
  type         PointsLedgerType @default(EARNED_PURCHASE)
  pointsChange Int
  balanceAfter Int
  reason       String?
  actorId      String?
  createdAt    DateTime         @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model LoyaltyReward {
  id             String   @id @default(cuid())
  restaurantId   String
  name           String   // e.g., "$10 Off Total Check", "Free Dessert"
  pointsRequired Int
  discountType   String   @default("FLAT") // 'FLAT' | 'PERCENTAGE'
  discountAmount Decimal  @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant  Restaurant          @relation(fields: [restaurantId], references: [id])
  redemptions LoyaltyRedemption[]
}

model LoyaltyRedemption {
  id             String   @id @default(cuid())
  customerId     String
  rewardId       String
  orderId        String?
  pointsRedeemed Int
  createdAt      DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id])
  reward   LoyaltyReward @relation(fields: [rewardId], references: [id])
}

model MarketingCampaign {
  id             String          @id @default(cuid())
  restaurantId   String
  title          String
  channel        CampaignChannel @default(EMAIL)
  status         CampaignStatus  @default(DRAFT)
  targetSegment  CampaignSegment @default(ALL)
  subject        String?
  messageBody    String
  couponId       String?
  recipientCount Int             @default(0)
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
}


// ─── AUDIT LOG (Phase D — Compliance Trail) ───────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  restaurantId String
  actorId      String   // userId who performed the action
  actorName    String
  action       String   // VOID_PAYMENT | EDIT_MENU_ITEM | CREATE_USER | CHANGE_USER_ROLE | VOID_ORDER | COMP_ORDER
  targetType   String   // Order | Payment | MenuItem | User
  targetId     String
  before       Json?    // State snapshot before the change
  after        Json?    // State snapshot after the change
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ─── ONLINE ORDERING MODULE ──────────────────────────────────────────────────

model OnlineOrderingConfig {
  id                    String @id @default(cuid())
  locationId            String @unique
  isEnabled             Boolean @default(true)
  isPaused              Boolean @default(false)
  pauseReason           String?
  acceptanceMode        OrderingAcceptanceMode @default(MANUAL)
  pickupEnabled         Boolean @default(true)
  deliveryEnabled       Boolean @default(true)
  dineInEnabled         Boolean @default(true)
  scheduledOrdersEnabled Boolean @default(true)
  pickupLeadMinutes     Int @default(20)
  deliveryLeadMinutes   Int @default(45)
  minimumPickupAmount   Decimal @db.Decimal(10, 2) @default(0)
  minimumDeliveryAmount Decimal @db.Decimal(10, 2) @default(0)
  deliveryRadiusKm      Float @default(8)
  deliveryFee           Decimal @db.Decimal(10, 2) @default(0)
  freeDeliveryThreshold Decimal? @db.Decimal(10, 2)
  serviceChargePercent  Decimal @db.Decimal(5, 2) @default(0)
  maximumOrdersPerSlot  Int @default(10)
  slotDurationMinutes   Int @default(15)
  customerInstructions  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  hours OnlineOrderingHours[]
}

model OnlineOrderingHours {
  id          String @id @default(cuid())
  configId    String
  dayOfWeek   Int
  orderType   FulfilmentType
  openTime    String
  closeTime   String
  isClosed    Boolean @default(false)

  config OnlineOrderingConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  @@unique([configId, dayOfWeek, orderType])
}

model OrderDeliveryAddress {
  id            String @id @default(cuid())
  orderId       String @unique
  locationId    String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  latitude      Float?
  longitude     Float?
  distanceKm    Float?
  instructions  String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])
}

model StripeEventLog {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  orderId     String?
  processedAt DateTime @default(now())

  @@index([eventId])
}

model OrderingHoliday {
  id         String   @id @default(cuid())
  locationId String
  name       String
  date       DateTime
  isClosed   Boolean  @default(true)
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@index([locationId, date])
}

// ─── MODULE 5: DELIVERY RECONCILIATION ──────────────────────────────────────

enum ReconciliationStatus {
  OPEN
  REVIEWING
  LOCKED
  EXPORTED
}

enum ExceptionType {
  UNMATCHED_ORDER
  AMOUNT_DIFF
  MISSING_PAYOUT
  DUPLICATE_IMPORT
}

model DeliveryProvider {
  id          String   @id @default(cuid())
  locationId  String
  name        String   // "UrbanPiper", "Swiggy", "Zomato", "DoorDash"
  slug        String   // "urbanpiper", "swiggy" etc.
  isActive    Boolean  @default(true)
  apiKey      String?
  webhookSecret String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location   Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  statements DeliveryStatement[]

  @@unique([locationId, slug])
  @@index([locationId])
}

model DeliveryStatement {
  id           String   @id @default(cuid())
  providerId   String
  locationId   String
  periodStart  DateTime
  periodEnd    DateTime
  rawCsvHash   String   // SHA-256 of uploaded CSV, for dedup
  importedAt   DateTime @default(now())
  importedBy   String?  // userId who uploaded
  totalGross   Float    @default(0)
  totalCommission Float @default(0)
  totalTax     Float    @default(0)
  totalRefunds Float    @default(0)
  totalAdjustments Float @default(0)
  expectedPayout Float  @default(0)
  lineCount    Int      @default(0)

  provider   DeliveryProvider      @relation(fields: [providerId], references: [id])
  location   Location              @relation(fields: [locationId], references: [id])
  lines      DeliveryStatementLine[]
  periods    ReconciliationPeriodStatement[]

  @@index([providerId, periodStart, periodEnd])
  @@index([locationId, periodStart])
}

model DeliveryStatementLine {
  id              String   @id @default(cuid())
  statementId     String
  externalOrderId String   // provider's order ID
  restoOrderId    String?  // matched OnlineOrder.id (null = unmatched)
  matchedAt       DateTime?
  orderDate       DateTime
  customerName    String?
  itemsJson       String?  // JSON array of line items from provider
  grossAmount     Float
  commission      Float    @default(0)
  tax             Float    @default(0)
  promotionAmount Float    @default(0)
  refundAmount    Float    @default(0)
  adjustment      Float    @default(0)
  netAmount       Float    // gross - commission - tax + adjustments - refunds
  paymentMethod   String?
  status          String?  // provider status string

  statement DeliveryStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, externalOrderId])
  @@index([statementId])
  @@index([externalOrderId])
  @@index([restoOrderId])
}

model ReconciliationPeriod {
  id         String                 @id @default(cuid())
  locationId String
  name       String                 // e.g. "Sep 2026 — UrbanPiper"
  periodStart DateTime
  periodEnd   DateTime
  status     ReconciliationStatus   @default(OPEN)
  lockedAt   DateTime?
  lockedBy   String?                // userId
  exportedAt DateTime?
  notes      String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  // Summary totals (updated on match)
  totalGross       Float @default(0)
  totalCommission  Float @default(0)
  totalTax         Float @default(0)
  totalRefunds     Float @default(0)
  totalNet         Float @default(0)
  matchedCount     Int   @default(0)
  unmatchedCount   Int   @default(0)
  exceptionCount   Int   @default(0)

  location     Location                          @relation(fields: [locationId], references: [id])
  statements   ReconciliationPeriodStatement[]
  exceptions   ReconciliationException[]

  @@index([locationId, periodStart])
  @@index([locationId, status])
}

model ReconciliationPeriodStatement {
  periodId    String
  statementId String

  period    ReconciliationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  statement DeliveryStatement    @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@id([periodId, statementId])
}

model ReconciliationException {
  id          String        @id @default(cuid())
  periodId    String
  lineId      String?       // DeliveryStatementLine id if applicable
  type        ExceptionType
  description String
  amount      Float?        // the discrepancy amount if type = AMOUNT_DIFF
  isResolved  Boolean       @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?       // userId
  resolutionNote String?
  createdAt   DateTime      @default(now())

  period ReconciliationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, isResolved])
  @@index([periodId, type])
}
