# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/resto_db"

# ─── AUTH (NextAuth v5) ───────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Connect webhook endpoint (Stripe Dashboard → Webhooks → "Events on Connected accounts")
# pointed at /api/ordering/payments/webhook with events: payment_intent.succeeded,
# payment_intent.payment_failed, account.updated
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
# Subscription billing gateway: dodo (default, merchant of record, USD + INR + everywhere else)
# or stripe (USD direct — local testing override only).
BILLING_PROVIDER="dodo"
STRIPE_PRICE_BASIC="price_..." # Monthly $50 Basic Plan Price ID (only for BILLING_PROVIDER=stripe)

# ─── DODO PAYMENTS (Restaurant subscriptions) ─────────────────────────────────
# From: https://app.dodopayments.com → Developer → API Keys
DODO_PAYMENTS_API_KEY="dodo_test_..."
# From: https://app.dodopayments.com → Developer → Webhooks
DODO_PAYMENTS_WEBHOOK_KEY="whsec_..."
DODO_PAYMENTS_ENVIRONMENT="test_mode" # test_mode or live_mode
# Product IDs from the Dodo dashboard (Products), one per plan tier
DODO_PAYMENTS_PRODUCT_STARTER="prod_..."
DODO_PAYMENTS_PRODUCT_PRO="prod_..."
DODO_PAYMENTS_PRODUCT_ENTERPRISE="prod_..."
# Webhook endpoint to register in the Dodo dashboard: /api/webhooks/dodo
# (subscribe to all subscription.* events + payment.succeeded / payment.failed)
# For INR checkout in India, enable Settings → Pricing → Adaptive Currency in Dodo.


# ─── CLOUDFLARE R2 (Receipts + Menu Images) ──────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="resto-assets"
R2_PUBLIC_URL="https://your-r2-public-domain.com"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── RESEND (Email Delivery — resend.com) ────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Your Restaurant <receipts@yourdomain.com>"

# ─── META WHATSAPP CLOUD API (International Guest Notifications) ────────────
# Obtain from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="1234567890..."
WHATSAPP_BUSINESS_ACCOUNT_ID="1234567890..."

# ─── TWILIO / SMS & WHATSAPP SANDBOX (Development & Fallback) ───────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"
# For WhatsApp Sandbox (mock/dev): set to Twilio's sandbox number "whatsapp:+14155238886"
# Guests join by texting "join <keyword>" to +1 415 523 8886
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── AI / RESTO IQ (Llama 3.1 8B via Groq Free Tier or Ollama) ───────────────
GROQ_API_KEY="gsk_..."
OLLAMA_HOST="http://localhost:11434"

# ─── DELIVERY WEBHOOK SECRETS (DoorDash, UberEats HMAC Verification) ─────────
DOORDASH_WEBHOOK_SECRET="whsec_doordash_..."
UBEREATS_WEBHOOK_SECRET="whsec_ubereats_..."
DELIVERY_WEBHOOK_SECRET="whsec_delivery_..."

# ─── SCALE / PERFORMANCE ──────────────────────────────────────────────────────
# Postgres connections per server instance. ~10 for Docker/Railway/Render; 2-3 on serverless.
DB_POOL_MAX="10"
DB_STATEMENT_TIMEOUT_MS="15000"

# ─── MARKETING ────────────────────────────────────────────────────────────────
# Where "Book a demo" requests are emailed (uses RESEND_API_KEY)
SALES_NOTIFY_EMAIL="you@yourdomain.com"
# Cookieless analytics (plausible.io). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ─── PROMINENTZ HQ ────────────────────────────────────────────────────────────
# Comma-separated emails of the Prominentz team allowed into /hq (cross-restaurant
# console). Everyone else gets a 404 there. Leave empty to keep /hq closed.
PLATFORM_ADMIN_EMAILS=""
