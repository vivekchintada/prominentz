# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/resto_db"

# ─── AUTH (NextAuth v5) ───────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASIC="price_..." # Monthly $40 Basic Plan Price ID


# ─── CLOUDFLARE R2 (Receipts + Menu Images) ──────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="resto-assets"
R2_PUBLIC_URL="https://your-r2-public-domain.com"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── RESEND (Email Delivery — resend.com) ────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Your Restaurant <receipts@yourdomain.com>"

# ─── META WHATSAPP CLOUD API (International Guest Notifications) ────────────
# Obtain from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="1234567890..."
WHATSAPP_BUSINESS_ACCOUNT_ID="1234567890..."

# ─── TWILIO / SMS & WHATSAPP SANDBOX (Development & Fallback) ───────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"
# For WhatsApp Sandbox (mock/dev): set to Twilio's sandbox number "whatsapp:+14155238886"
# Guests join by texting "join <keyword>" to +1 415 523 8886
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── AI / RESTO IQ (Llama 3.1 8B via Groq Free Tier or Ollama) ───────────────
GROQ_API_KEY="gsk_..."
OLLAMA_HOST="http://localhost:11434"

# ─── DELIVERY WEBHOOK SECRETS (DoorDash, UberEats HMAC Verification) ─────────
DOORDASH_WEBHOOK_SECRET="whsec_doordash_..."
UBEREATS_WEBHOOK_SECRET="whsec_ubereats_..."
DELIVERY_WEBHOOK_SECRET="whsec_delivery_..."


