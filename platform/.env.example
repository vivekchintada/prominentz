# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/resto_db"

# ─── AUTH (NextAuth v5) ───────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Connect webhook endpoint (Stripe Dashboard → Webhooks → "Events on Connected accounts")
# pointed at /api/ordering/payments/webhook with events: payment_intent.succeeded,
# payment_intent.payment_failed, account.updated
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
# Subscription billing gateway: revenuecat (USD), stripe (USD) or cashfree (INR).
# Defaults to revenuecat when RevenueCat is configured, otherwise stripe when keys are set.
BILLING_PROVIDER="revenuecat"
STRIPE_PRICE_BASIC="price_..." # Monthly $50 Basic Plan Price ID (only for BILLING_PROVIDER=stripe)

# ─── REVENUECAT (Restaurant subscriptions) ────────────────────────────────────
# Secret API key (v1, starts with sk_): Project settings → API keys
REVENUECAT_SECRET_API_KEY="sk_..."
# OPTIONAL Web Purchase Links, one per plan (need RevenueCat Web Billing, which runs on Stripe).
# Leave empty to sell through the mobile app only (App Store / Google Play); the web billing
# page then tells owners to subscribe in the app. The restaurant ID is appended as the app user ID.
REVENUECAT_PURCHASE_LINK_STARTER="https://pay.rev.cat/..."
REVENUECAT_PURCHASE_LINK_PRO="https://pay.rev.cat/..."
REVENUECAT_PURCHASE_LINK_ENTERPRISE="https://pay.rev.cat/..."
# Entitlement identifiers for each plan (defaults: basic, pro, enterprise)
REVENUECAT_ENTITLEMENT_STARTER="basic"
REVENUECAT_ENTITLEMENT_PRO="pro"
REVENUECAT_ENTITLEMENT_ENTERPRISE="enterprise"
# Webhook (Integrations → Webhooks) → URL /api/webhooks/revenuecat, Authorization header = this value
REVENUECAT_WEBHOOK_AUTH="long-random-string"
# Set to "true" only while testing sandbox purchases against production
REVENUECAT_ALLOW_SANDBOX="false"

# ─── CASHFREE (Subscriptions & SaaS Billing) ──────────────────────────────────
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret"
CASHFREE_ENVIRONMENT="SANDBOX" # SANDBOX or PRODUCTION
CASHFREE_PLAN_STARTER="plan_starter_monthly"
CASHFREE_PLAN_PRO="plan_pro_monthly"
CASHFREE_PLAN_ENTERPRISE="plan_enterprise_monthly"


# ─── CLOUDFLARE R2 (Receipts + Menu Images) ──────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="resto-assets"
R2_PUBLIC_URL="https://your-r2-public-domain.com"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── RESEND (Email Delivery — resend.com) ────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Your Restaurant <receipts@yourdomain.com>"

# ─── META WHATSAPP CLOUD API (International Guest Notifications) ────────────
# Obtain from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="1234567890..."
WHATSAPP_BUSINESS_ACCOUNT_ID="1234567890..."

# ─── TWILIO / SMS & WHATSAPP SANDBOX (Development & Fallback) ───────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"
# For WhatsApp Sandbox (mock/dev): set to Twilio's sandbox number "whatsapp:+14155238886"
# Guests join by texting "join <keyword>" to +1 415 523 8886
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── AI / RESTO IQ (Llama 3.1 8B via Groq Free Tier or Ollama) ───────────────
GROQ_API_KEY="gsk_..."
OLLAMA_HOST="http://localhost:11434"

# ─── DELIVERY WEBHOOK SECRETS (DoorDash, UberEats HMAC Verification) ─────────
DOORDASH_WEBHOOK_SECRET="whsec_doordash_..."
UBEREATS_WEBHOOK_SECRET="whsec_ubereats_..."
DELIVERY_WEBHOOK_SECRET="whsec_delivery_..."

# ─── SCALE / PERFORMANCE ──────────────────────────────────────────────────────
# Postgres connections per server instance. ~10 for Docker/Railway/Render; 2-3 on serverless.
DB_POOL_MAX="10"
DB_STATEMENT_TIMEOUT_MS="15000"

# ─── MARKETING ────────────────────────────────────────────────────────────────
# Where "Book a demo" requests are emailed (uses RESEND_API_KEY)
SALES_NOTIFY_EMAIL="you@yourdomain.com"
# Cookieless analytics (plausible.io). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
